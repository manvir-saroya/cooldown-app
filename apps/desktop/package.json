{
  "name": "@cooldown/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cooldown desktop app: Tauri 2 shell around @cooldown/ui.",
  "scripts": {
    "dev:web": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build:web": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sidecar": "node scripts/build-sidecar.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@cooldown/snapshot-schema": "*",
    "@cooldown/ui": "*",
    "@tauri-apps/api": "^2.12.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
