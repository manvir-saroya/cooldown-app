{
  "name": "@cooldown/snapshot-schema",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Versioned Snapshot / SyncPayload contract shared by every Cooldown component.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema/snapshot.schema.json": "./schema/snapshot.schema.json",
    "./schema/sync-payload.schema.json": "./schema/sync-payload.schema.json",
    "./fixtures/*": "./fixtures/*"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:schema": "node scripts/build-schema.ts"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
